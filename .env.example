# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — server-side only, NEVER expose to the browser.
# Used by admin server actions and by scripts/seed-from-manifest.mjs.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: order + newsletter email notifications (resend.com free tier).
# Without these, checkout/signup still work, just no emails go out.
RESEND_API_KEY=re_...
OWNER_NOTIFICATION_EMAIL=owner@example.com

# Public site URL — used for the sitemap, robots.txt, and social share links.
# Update this when the site moves to a custom domain.
NEXT_PUBLIC_SITE_URL=https://candid-custard-6b4197.netlify.app

# Cloudflare R2 (Storage & databases > R2 Object Storage > Manage API Tokens
# in the Cloudflare dashboard). Every image upload goes here instead of
# Supabase Storage — R2 has zero egress fees, unlike Supabase.
R2_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=houseofoptics
# The bucket's Public Development URL (R2 > bucket > Settings > Public
# Development URL), no trailing slash.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
