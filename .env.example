# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — server-side only, NEVER expose to the browser.
# Used by admin server actions and by scripts/seed-from-manifest.mjs.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: order + newsletter email notifications (resend.com free tier).
# Without these, checkout/signup still work, just no emails go out.
RESEND_API_KEY=re_...
OWNER_NOTIFICATION_EMAIL=owner@example.com

# Optional: automatic WhatsApp alert to the owner on every new order, via
# callmebot.com (free, personal-use WhatsApp notifications — not the
# official WhatsApp Business API). Setup:
#   1. Save +34 623 78 95 95 as a contact on the owner's phone.
#   2. From that phone, send it the WhatsApp message:
#      "I allow callmebot to send me messages"
#   3. Within ~2 minutes it replies with an API key.
CALLMEBOT_PHONE=96181701556
CALLMEBOT_APIKEY=...
